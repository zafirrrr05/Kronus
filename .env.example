# Copy to .env and fill in. .env is git-ignored (SR-2) — never commit real
# credentials. See docs/setup.md for the full walkthrough.

# --- Ingestion Pipeline / Event Stream ---
# "memory" needs nothing further (default, used by tests/demo).
# "redpanda" requires a broker reachable at the bootstrap address below.
KRONUS_EVENT_BUS_BACKEND=memory
KRONUS_REDPANDA_BOOTSTRAP=localhost:9092

# --- Logbook ---
# "sqlite" needs nothing further (default, used by tests/demo).
# "postgres" requires a reachable Postgres and the DSN below.
KRONUS_LOGBOOK_BACKEND=sqlite
KRONUS_POSTGRES_DSN=dbname=kronus user=kronus password=kronus_dev_local host=localhost
KRONUS_SQLITE_PATH=data/logbook.db

# --- Response Engine ---
KRONUS_OPA_BINARY=opa
KRONUS_POLICY_DIR=policy
KRONUS_DRY_RUN_MODE=false

# --- LLM Explainer ---
# Leave empty to run the Explainer in offline/templated mode (no API calls,
# no cost, demo still runs end to end) — see docs/instructions.md.
ANTHROPIC_API_KEY=
KRONUS_ANTHROPIC_MODEL=claude-sonnet-5

# --- Observability ---
KRONUS_METRICS_PORT=9100

# --- Decoy (Moving Target Defense) ---
KRONUS_DECOY_SSH_PORT=2222
KRONUS_REAL_SSH_PORT=2022

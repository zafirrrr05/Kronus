__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/

.venv/
venv/
bin/

# SR-2: never commit real secrets. .env is local-dev only.
.env

# Real, synthetic, and decoy-captured data are fetched/generated locally,
# not committed — see docs/setup.md for how to populate these.
data/real/*
data/synthetic/*
data/decoy_captures/*
!data/real/.gitkeep
!data/synthetic/.gitkeep
!data/decoy_captures/.gitkeep

# Trained model artifacts are reproducible from services/*/train.py — not
# committed, to keep the repo a source tree, not a binary-artifact store.
models/registry/*
!models/registry/.gitkeep

# Experiment weights (reproducible via scripts/run_*_experiment.py)
models/experiments/*
!models/experiments/.gitkeep

# Experiment results (JSON metrics — lightweight, committed intentionally)
# results/ is committed — see results/experiments/*.json

# External datasets (large; fetched per-experiment, never committed).
# `*/*` ignores each dataset's contents but NOT the dataset directory itself,
# so the .gitkeep placeholder inside each one can still be re-included below.
# This covers every dataset, not just CIC-IDS2017 — new experiment datasets are
# multi-GB raw corpora and must never enter the repo.
data/external/*/*
!data/external/*/.gitkeep

# data/api/ previously held synthetic generated events — that experiment has been
# removed. The directory is kept as a placeholder; nothing in it is committed.
data/api/*
!data/api/.gitkeep

*.db
*.db-journal
kronus_demo_report.json
# Private files
claude.md
readme_og.md
docs/architecture/Kronus_architecture.drawio
build.md
frontend.md

# Ignore everything in infra folder (no files should be pushed)
infra/

# Ignore generated infra artefacts (state files, secrets, etc.)
infra/*.tfstate
infra/.terraform/
infra/*.env
infra/*.key
infra/*.pem
infra/*.secret
